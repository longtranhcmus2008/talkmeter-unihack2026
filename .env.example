# Copy this file to .env.local and fill it in. Never commit .env.local.

# fuji (test USDC, dùng cho demo) hoặc mainnet (USDC thật trên C-Chain).
NETWORK=fuji

# Ví nhận tiền (seller): địa chỉ ví Core của nhóm.
PAY_TO=

# Facilitator kiểm tra chữ ký và đưa giao dịch lên chain. Hai facilitator công khai hỗ trợ Fuji:
#   https://facilitator.ultravioletadao.xyz
#   https://facilitator.payai.network
# Dự phòng khi demo: chạy `npm run facilitator` rồi đặt http://localhost:4022
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# Groq: Whisper large-v3 cho STT và LLM cho bản tóm tắt. Key miễn phí tại console.groq.com
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Tên riêng giúp Whisper viết đúng (tên thành viên, tên dự án).
# STT_PROMPT=TalkMeter, Avalanche, Fuji, USDC, x402, Đạt, Dũng

# Giá mỗi đoạn âm thanh và mỗi bản tóm tắt, tính bằng USDC. Giao diện đọc giá từ đây.
# Video demo 15 giây/đoạn: có thể đặt PRICE_TRANSCRIBE=0.005 và ghi chú trên màn hình.
PRICE_TRANSCRIBE=0.02
PRICE_SUMMARY=0.05

# Receipt on-chain: ví operator (cần ít AVAX test) và địa chỉ ReceiptLog từ `npm run deploy-receipt`.
OPERATOR_PRIVATE_KEY=
RECEIPT_CONTRACT=

# Chỉ dùng cho `npm run pay` (thử x402 bằng dòng lệnh) và `npm run test-ai`.
BUYER_PRIVATE_KEY=
PRICE_USDC=0.001
MAX_PRICE_USDC=0.1

# Chỉ dùng cho `npm run facilitator`: khóa ví có ít AVAX để trả gas.
# FACILITATOR_PRIVATE_KEY=

# PORT=4021
# RPC_URL=
